<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="secure_store.xml" />
        <exclude domain="file" path="snapshot.enc" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_store.xml" />
        <exclude domain="file" path="snapshot.enc" />
    </device-transfer>
</data-extraction-rules>
